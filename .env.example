# Copy to .env.local and fill in. Never commit real values — .env* is gitignored.
# Secrets live in env only (design/Vyora Build Roadmap.dc.html, coding rules).

# --- Public (inlined into the browser bundle — treat as public) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Server only (never expose to the client) ---
# Bypasses RLS. Used by edge functions and server routes only.
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI provider router (Phase 5) ---
# Keys are held by Supabase Edge Functions, not the app.
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# OPENROUTER_API_KEY=""
