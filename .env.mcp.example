# MCP credentials — copy to .env.mcp and fill in what you have.
# .env.mcp is gitignored. Claude Code expands ${VAR} in .mcp.json from the
# PROCESS environment, so these must be exported BEFORE launching `claude`.
#
#   git-bash:   set -a; source .env.mcp; set +a; claude
#   PowerShell: Get-Content .env.mcp | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { $env:($matches[1].Trim()) = $matches[2].Trim('"') } }; claude

# --- supabase (remote project, read-only) ---
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""
# Defaults to the Vyora project (vxxfmgigfsgxzbxldqyk) if unset. A project ref
# is public (it is in the project URL) — only the access token is a secret.
SUPABASE_PROJECT_REF=""

# --- postgres-local ---
# Defaults to the local Supabase stack (supabase start) if unset:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Set this to point dbhub at a different database instead.
SUPABASE_DB_URL=""

# --- context7 (optional) ---
# Works unauthenticated; a key raises rate limits. https://context7.com/dashboard
CONTEXT7_API_KEY=""

# --- github ---
# No token needed. The remote server uses OAuth — run /mcp and authenticate.
